msgstr "Perfil de colunas"

#: views/wpbe.php:900
msgid "Here you can load previously saved columns profile. After pressing on the load button, page reloading will start immediately!"
msgstr "Aqui pode carregar um perfil de colunas guardado anteriormente. Depois de premir o botão de carregar, a página será recarregada de imediato!"

#. translators: 1: profile title, 2: delete profile link
#: views/wpbe.php:906
#, php-format
msgid "Current profile is: %1$s %2$s"
msgstr "O perfil atual é: %1$s %2$s"

#: views/wpbe.php:910
msgid "remove current columns profile"
msgstr "remover o perfil de colunas atual"

#: views/wpbe.php:922
msgid "Select profile to load"
msgstr "Selecione o perfil a carregar"

#: views/wpbe.php:942
msgid "New Profile"
msgstr "Novo perfil"

#: views/wpbe.php:943
msgid "Here you can type any title and save current columns set and their order. Type here any title and then press Save button OR press Enter button on your keyboard!"
msgstr "Aqui pode escrever um título e guardar o conjunto de colunas atual e a sua ordem. Escreva aqui um título e prima o botão Guardar OU a tecla Enter do teclado!"

#: views/wpbe.php:955
#: views/wpbe.php:1011
msgid "Create"
msgstr "Criar"

#. translators: %s: taxonomy/term placeholder
#: views/wpbe.php:972
#, php-format
msgid "New term for [%s]"
msgstr "Novo termo para [%s]"

#: views/wpbe.php:979
msgid "New Term(s)"
msgstr "Novo(s) termo(s)"

#: views/wpbe.php:980
msgid "Here you can write title for the new term. Use comma to create some new tags on the same time! New terms with already existed names will not be created!"
msgstr "Aqui pode escrever o título do novo termo. Utilize vírgulas para criar várias etiquetas em simultâneo! Os novos termos com nomes já existentes não serão criados!"

#: views/wpbe.php:990
msgid "Slug(s) of the new term"
msgstr "Slug(s) do novo termo"

#: views/wpbe.php:991
msgid "Here you can write slug for the the new term (optionally). Use comma for slug(s) when you create some on the same time terms, or leave slug field empty to create slug(s) automatically"
msgstr "Aqui pode escrever o slug do novo termo (opcional). Utilize vírgulas para os slugs ao criar vários termos em simultâneo, ou deixe o campo do slug vazio para criar os slugs automaticamente"

#: views/wpbe.php:1001
msgid "Parent of the new term(s)"
msgstr "Superior do(s) novo(s) termo(s)"

#: views/wpbe.php:1002
msgid "Here you can select parent for the the new term (optionally)"
msgstr "Aqui pode selecionar o termo superior do novo termo (opcional)"

